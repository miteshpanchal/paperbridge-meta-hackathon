PORT=4310
HOST=127.0.0.1
APP_URL=http://localhost:4310
# For clarifycue.com/hackathon, set BASE_PATH=/hackathon and APP_URL to the full URL.
BASE_PATH=
JUDGE_EMAIL=judge@paperbridge.demo
JUDGE_PASSWORD=
SESSION_SECRET=
# All question content comes from actual uploads and live model requests.
# Configure this server-only key before digitizing. There is no offline content fallback.
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
PYTHON=python
DATA_DIR=.data
# On Cloud Run use a dedicated PRIVATE Cloud Storage bucket; overrides DATA_DIR.
# The attached service account needs object read/create/update permissions on this bucket.
DATA_BUCKET=
# Optional: a real processed upload to show as before/after evidence on the introduction.
# Alternatively choose a processed page in the workspace and publish its introduction preview.
SHOWCASE_PAPER_ID=
# Point to a dedicated ClarifyCue DEMO deployment, never a production student DB.
CLARIFYCUE_API_URL=http://localhost:3001/api
CLARIFYCUE_PAPER_API_KEY=
CLARIFYCUE_EXAM_ID=
